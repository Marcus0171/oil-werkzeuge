# Zeilenenden festlegen. Der Waechter laeuft unter Windows, das Dashboard
# meist auf einem Linux-Server - ohne diese Regeln wechseln die Zeilenenden
# bei jedem Rechnerwechsel und blaehen die Diffs auf.
* text=auto eol=lf

*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.vbs  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf
